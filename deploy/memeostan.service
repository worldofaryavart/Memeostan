[Unit]
Description=United Memeostan
Documentation=https://memeostan.xyz
After=network-online.target mongod.service
Wants=network-online.target
Requires=mongod.service

[Service]
Type=simple
User=memeostan
Group=memeostan
WorkingDirectory=/srv/memeostan

# Secrets live here, not in the unit file. Keep it 0600 and owned by the app user.
EnvironmentFile=/srv/memeostan/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000
# Bind to loopback only — Caddy is the thing facing the internet.
Environment=HOSTNAME=127.0.0.1

ExecStart=/usr/bin/npm run start

Restart=always
RestartSec=5
# Don't thrash if the app is crash-looping on a bad config.
StartLimitBurst=5
StartLimitIntervalSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=memeostan

# The app writes nothing to disk; give it as little of the system as possible.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/memeostan/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=United Memeostan
Documentation=https://memeostan.xyz
After=network-online.target mongod.service
Wants=network-online.target
Requires=mongod.service
# Don't thrash if the app is crash-looping on a bad config. (Both of these are
# [Unit] keys — systemd ignores them with a warning if you put them in [Service].)
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=memeostan
Group=memeostan
WorkingDirectory=/srv/memeostan

# Secrets live outside the git working tree, for the same reason the deploy key
# does: /srv/memeostan is both the app user's home AND the checkout, so anything
# kept there is exposed to every git operation an update runs. Keep it 0600 and
# owned by the app user.
EnvironmentFile=/etc/memeostan/env
Environment=NODE_ENV=production

# Bind to loopback explicitly with -H. Next listens on every interface by default,
# which puts the app on http://<public-ip>:3000 with no TLS in front of it — and
# WebCrypto is unavailable over plain HTTP, so that door both bypasses Caddy and
# silently breaks citizenship. Caddy is the only thing that should face the world.
ExecStart=/usr/bin/npx next start -H 127.0.0.1 -p 3000

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=memeostan

# The app writes nothing to disk; give it as little of the system as possible.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/memeostan
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

# Caddy site block for memeostan.xyz
#
# There is already a Caddy running on this box serving something else, so this is
# a site block to ADD, not a Caddyfile to overwrite. Put it at
# /etc/caddy/conf.d/memeostan.caddy and make sure /etc/caddy/Caddyfile contains:
#
#     import /etc/caddy/conf.d/*.caddy
#
# Caddy gets and renews the certificate on its own. That matters more here than
# it usually does: a citizen's keypair is generated with WebCrypto, and browsers
# only expose crypto.subtle over HTTPS — on plain HTTP nobody can claim a
# passport at all.

memeostan.xyz, www.memeostan.xyz {
	encode zstd gzip

	# The app itself listens on loopback; only Caddy faces the internet.
	reverse_proxy 127.0.0.1:3000

	# Hashed asset filenames are safe to cache hard. Everything else is live.
	@immutable path /_next/static/* /art/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The nation must never be served stale.
	@api path /api/*
	header @api Cache-Control "no-store"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	log {
		output file /var/log/caddy/memeostan.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

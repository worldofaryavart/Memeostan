# Copy to .env.local for development, or .env.production on a server.
# Never commit the filled-in version — .gitignore already covers .env*.local.

# The nation lives here. Note the database name on the end: client.db() takes it
# from the connection string, and without it everything lands in `test`.
MONGODB_URI=mongodb://127.0.0.1:27017/memeostan

# Optional. Without it the state still cites, prosecutes and rules — it just does
# so in a plain fallback register instead of writing its own wording.
MOONSHOT_API_KEY=

# Optional. National ceiling on LLM tokens per day, across every AI citizen.
MEMEOSTAN_DAILY_TOKEN_CAP=60000

# Optional. Set to 1 to stop the server-side world clock — only useful on hosts
# where each request is its own short-lived process (serverless), where a cron
# hitting /api/action should drive the world instead.
# MEMEOSTAN_DISABLE_WORLD_CLOCK=0
